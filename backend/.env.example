# RSSB Office Data Platform — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# Database
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/office_data_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=office_data_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
APP_ENV=development

# Optional AI Query Planner (Phase 2.4)
# IMPORTANT: The platform works fully without an external AI API.
# The deterministic/local query planner is the default and fallback.
AI_PLANNER_ENABLED=false
# AI_PROVIDER=mock
# AI_API_KEY=
# AI_MODEL=gemini-1.5-flash

# Authentication & Office Permissions (Phase 2.5)
JWT_SECRET_KEY=rssb-office-data-platform-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENFORCED=false
